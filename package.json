{
  "name": "heatmap",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@heatmap/api",
    "dev:web": "turbo run dev --filter=@heatmap/web",
    "build": "turbo run build",
    "build:api": "turbo run build --filter=@heatmap/api",
    "build:web": "turbo run build --filter=@heatmap/web",
    "lint": "turbo run lint",
    "lint:web": "turbo run lint --filter=@heatmap/web",
    "lint:api": "turbo run lint --filter=@heatmap/api",
    "fmt": "oxfmt",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "oxfmt": "^0.47.0",
    "turbo": "^2.5.3"
  },
  "packageManager": "bun@1.3.11"
}
